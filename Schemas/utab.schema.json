{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "utab.schema.json",
  "title": "Universal Tabs Document",
  "description": "Exploratory schema for the utab 0.1-draft JSON serialization.",
  "type": "object",
  "required": ["utab", "setup", "tracks"],
  "properties": {
    "utab": { "$ref": "#/$defs/metadata" },
    "setup": { "$ref": "#/$defs/setup" },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$"
    },
    "rational": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$" }
      ]
    },
    "metadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "documentId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "work": {
          "type": "object",
          "properties": {
            "number": { "type": "string" }, "title": { "type": "string" }, "opus": { "type": "string" }
          },
          "additionalProperties": true
        },
        "movement": {
          "type": "object",
          "properties": { "number": { "type": "string" }, "title": { "type": "string" } },
          "additionalProperties": true
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name"],
            "properties": { "name": { "type": "string" }, "role": { "type": "string" } },
            "additionalProperties": true
          }
        },
        "rights": {
          "type": "array",
          "items": {
            "type": "object", "required": ["text"],
            "properties": { "text": { "type": "string" }, "type": { "type": "string" } },
            "additionalProperties": true
          }
        },
        "source": { "type": "string" },
        "relations": { "type": "array", "items": { "type": "string" } },
        "encoding": {
          "type": "object",
          "properties": {
            "date": { "type": "string" },
            "software": { "type": "array", "items": { "type": "string" } },
            "encoders": { "type": "array", "items": { "type": "string" } },
            "description": { "type": "string" }
          },
          "additionalProperties": true
        },
        "miscellaneous": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "setup": {
      "type": "object",
      "required": ["profiles", "instruments"],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "profile.schema.json" },
              { "$ref": "#/$defs/profileReference" }
            ]
          }
        },
        "instruments": {
          "type": "array",
          "items": { "$ref": "#/$defs/instrument" }
        },
        "performers": {
          "type": "array",
          "items": { "$ref": "#/$defs/performer" }
        },
        "time": { "$ref": "#/$defs/timeSetup" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        },
        "arrangement": {
          "type": "array",
          "items": { "$ref": "#/$defs/arrangementEntry" }
        },
        "tunings": { "type": "array", "items": { "$ref": "#/$defs/tuning" } }
      },
      "additionalProperties": true
    },
    "profileReference": {
      "type": "object",
      "required": ["id", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "instrument": {
      "type": "object",
      "required": ["id", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "profile": { "$ref": "#/$defs/identifier" },
        "configuration": { "type": "object" }
      },
      "additionalProperties": true
    },
    "performer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tuning": {
      "type": "object",
      "required": ["id", "type", "periodRatio", "reference"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["equalDivision", "ratioScale"] },
        "periodRatio": { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" },
        "divisions": { "type": "integer", "minimum": 1 },
        "degrees": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "names": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "reference": {
          "type": "object",
          "required": ["pitch", "frequencyHz"],
          "properties": {
            "pitch": { "type": "object", "required": ["degree", "period"], "properties": { "degree": { "type": "integer", "minimum": 0 }, "period": { "type": "integer" } } },
            "frequencyHz": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "equalDivision" } } }, "then": { "required": ["divisions"] } },
        { "if": { "properties": { "type": { "const": "ratioScale" } } }, "then": { "required": ["degrees"] } }
      ]
    },
    "section": {
      "type": "object",
      "required": ["id", "length"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "length": {
          "type": "object",
          "required": ["measures"],
          "properties": {
            "measures": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "meterMap": {
          "type": "array",
          "items": { "$ref": "#/$defs/meter" }
        }
      },
      "additionalProperties": true
    },
    "arrangementEntry": {
      "type": "object",
      "required": ["id", "section"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "section": { "$ref": "#/$defs/identifier" },
        "playCount": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "additionalProperties": true
    },
    "timeSetup": {
      "type": "object",
      "properties": {
        "meter": { "$ref": "#/$defs/meter" },
        "tempo": { "$ref": "#/$defs/tempo" },
        "meterMap": {
          "type": "array",
          "items": { "$ref": "#/$defs/meter" }
        },
        "tempoMap": {
          "type": "array",
          "items": { "$ref": "#/$defs/tempo" }
        },
        "absoluteOrigin": { "$ref": "#/$defs/quantity" }
      },
      "additionalProperties": true
    },
    "meter": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "at": { "type": "object" },
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "tempo": {
      "type": "object",
      "required": ["quarterNotesPerMinute"],
      "properties": {
        "at": { "type": "object" },
        "quarterNotesPerMinute": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "track": {
      "type": "object",
      "required": ["id", "instrument"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string" },
        "instrument": { "$ref": "#/$defs/identifier" },
        "performer": { "$ref": "#/$defs/identifier" },
        "role": { "type": "string" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/trackPart" }
        }
      },
      "additionalProperties": true,
      "oneOf": [
        { "required": ["events"] },
        { "required": ["parts"] }
      ]
    },
    "trackPart": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "section": { "$ref": "#/$defs/identifier" },
        "entry": { "$ref": "#/$defs/identifier" },
        "mode": { "enum": ["replace", "overlay"] },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      },
      "additionalProperties": true,
      "oneOf": [
        { "required": ["section"] },
        { "required": ["entry"] }
      ]
    },
    "event": {
      "type": "object",
      "required": ["at"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "at": { "$ref": "#/$defs/timePosition" },
        "duration": { "$ref": "#/$defs/duration" },
        "type": { "enum": ["action", "state", "control", "gesture"] },
        "action": { "type": "string", "minLength": 1 },
        "gesture": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "parameter": { "type": "string" },
        "parameters": { "type": "object" },
        "techniques": { "type": "array", "items": { "type": "string" } },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stateChange" }
        },
        "curve": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true,
      "anyOf": [
        { "required": ["action", "target"] },
        { "required": ["action", "targets"] },
        { "required": ["gesture", "target"] },
        { "required": ["gesture", "targets"] },
        { "required": ["changes"] },
        { "required": ["target", "parameter", "curve"] }
      ],
      "not": { "required": ["target", "targets"] }
    },
    "stateChange": {
      "type": "object",
      "required": ["target", "parameter", "value"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "parameter": { "type": "string", "minLength": 1 },
        "value": {}
      },
      "additionalProperties": true
    },
    "timePosition": {
      "type": "object",
      "oneOf": [
        {
          "required": ["musical"],
          "properties": { "musical": { "$ref": "#/$defs/musicalPosition" } }
        },
        {
          "required": ["absolute"],
          "properties": { "absolute": { "$ref": "#/$defs/quantity" } }
        }
      ]
    },
    "musicalPosition": {
      "type": "object",
      "required": ["measure"],
      "properties": {
        "measure": { "type": "integer", "minimum": 1 },
        "beat": { "type": "integer", "minimum": 1 },
        "offset": { "$ref": "#/$defs/rational" }
      },
      "additionalProperties": true
    },
    "duration": {
      "type": "object",
      "oneOf": [
        {
          "required": ["quarterNotes"],
          "properties": { "quarterNotes": { "$ref": "#/$defs/rational" } }
        },
        {
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
