title "Twinkle Twinkle Little Star"
meter 4/4
tempo 100
scale C major

instrument piano_i : "instrument:piano:88-key" as "Piano"
instrument guitar_i : "instrument:guitar:classical-six-string" as "Rhythm Guitar"
instrument guitar_ii : "instrument:guitar:classical-six-string" as "Lead Guitar"
instrument voice_i : "instrument:voice:generic" as "Vocals"

phrase melody {
    bar {
        @1[4] q
        @1[4] q
        @5[4] q
        @5[4] q
    }
    bar {
        @6[4] q
        @6[4] q
        @5[4] h
    }
}

phrase harmony {
    bar { chord C major w }
    bar { chord C major w }
}

section verse : 2 bars {
    piano_i {
        voice melody { melody }
        voice accompaniment { harmony }
    }
    guitar_i {
        voice rhythm { harmony }
    }
    guitar_ii {
        voice lead { melody }
    }
    voice_i {
        voice melody {
            lyrics { "Twin-kle twin-kle lit-tle star" }
            melody
        }
    }
}

main {
    verse
}
