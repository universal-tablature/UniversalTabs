{
  "utab": {
    "version": "0.1-draft",
    "documentId": "example:sectioned-song",
    "title": "Repeated Sections with Unique Vocals"
  },
  "setup": {
    "profiles": [
      {
        "id": "profile:guitar",
        "name": "Six-string Fretted Guitar",
        "actuators": { "strings": { "count": 6 } },
        "interactions": { "pluck": { "targets": ["strings"] } }
      },
      {
        "id": "profile:voice",
        "name": "Voice",
        "actuators": { "voice": { "type": "continuous" } },
        "interactions": { "sing": { "targets": ["voice"] } }
      }
    ],
    "tunings": [
      {
        "id": "12edo",
        "type": "equalDivision",
        "periodRatio": "2/1",
        "divisions": 12,
        "reference": { "pitch": { "degree": 9, "period": 4 }, "frequencyHz": 440 },
        "names": { "C": 0, "C#": 1, "D": 2, "D#": 3, "E": 4, "F": 5, "F#": 6, "G": 7, "G#": 8, "A": 9, "A#": 10, "B": 11 }
      }
    ],
    "instruments": [
      {
        "id": "guitar-1",
        "profile": "profile:guitar",
        "configuration": {
          "tuning": [
            { "tuning": "12edo", "name": "E", "period": 2 },
            { "tuning": "12edo", "name": "A", "period": 2 },
            { "tuning": "12edo", "name": "D", "period": 3 },
            { "tuning": "12edo", "name": "G", "period": 3 },
            { "tuning": "12edo", "name": "B", "period": 3 },
            { "tuning": "12edo", "name": "E", "period": 4 }
          ],
          "stringIndexOrder": "highest-to-lowest"
        }
      },
      { "id": "voice-1", "profile": "profile:voice" }
    ],
    "time": {
      "tempoMap": [
        { "at": { "entry": "verse-1", "measure": 1, "beat": 1 }, "quarterNotesPerMinute": 100 },
        { "at": { "entry": "chorus-1", "measure": 1, "beat": 1 }, "quarterNotesPerMinute": 112 },
        { "at": { "entry": "verse-2", "measure": 1, "beat": 1 }, "quarterNotesPerMinute": 100 }
      ]
    },
    "sections": [
      {
        "id": "verse",
        "name": "Verse",
        "role": "verse",
        "length": { "measures": 1 },
        "meterMap": [
          { "at": { "measure": 1 }, "numerator": 4, "denominator": 4 }
        ]
      },
      {
        "id": "chorus",
        "name": "Chorus",
        "role": "chorus",
        "length": { "measures": 1 },
        "meterMap": [
          { "at": { "measure": 1 }, "numerator": 4, "denominator": 4 }
        ]
      }
    ],
    "arrangement": [
      { "id": "verse-1", "section": "verse" },
      { "id": "chorus-1", "section": "chorus", "playCount": 2 },
      { "id": "verse-2", "section": "verse" }
    ]
  },
  "tracks": [
    {
      "id": "track:guitar",
      "instrument": "guitar-1",
      "parts": [
        {
          "section": "verse",
          "events": [
            { "at": { "musical": { "measure": 1, "beat": 1 } }, "action": "pluck", "target": "strings[6]" }
          ]
        },
        {
          "section": "chorus",
          "events": [
            { "at": { "musical": { "measure": 1, "beat": 1 } }, "action": "pluck", "target": "strings[5]" }
          ]
        }
      ]
    },
    {
      "id": "track:vocals",
      "instrument": "voice-1",
      "parts": [
        {
          "section": "verse",
          "events": [
            { "at": { "musical": { "measure": 1, "beat": 1 } }, "action": "sing", "target": "voice", "parameters": { "pitch": { "tuning": "12edo", "name": "G", "period": 4 } } }
          ]
        },
        {
          "entry": "verse-1",
          "mode": "replace",
          "events": [
            { "at": { "musical": { "measure": 1, "beat": 1 } }, "action": "sing", "target": "voice", "parameters": { "pitch": { "tuning": "12edo", "name": "A", "period": 4 } } }
          ]
        },
        {
          "entry": "verse-2",
          "mode": "replace",
          "events": [
            { "at": { "musical": { "measure": 1, "beat": 1 } }, "action": "sing", "target": "voice", "parameters": { "pitch": { "tuning": "12edo", "name": "B", "period": 4 } } }
          ]
        },
        {
          "section": "chorus",
          "events": [
            { "at": { "musical": { "measure": 1, "beat": 1 } }, "action": "sing", "target": "voice", "parameters": { "pitch": { "tuning": "12edo", "name": "C", "period": 5 } } }
          ]
        }
      ]
    }
  ]
}
