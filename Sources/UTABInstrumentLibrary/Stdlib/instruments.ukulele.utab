module instruments.ukulele
import profiles.core
import std.midi

model SopranoUkulele : FrettedStrings {
    id "instrument:ukulele:soprano"
    name "Soprano Ukulele"
    midiProgram = midi.nylonStringGuitar
    geometry strings { count 4; reentrant true }
    geometry frets { count 15; movable false }
}

extension SopranoUkulele {
    tuning highG default {
        id "tuning:ukulele:soprano-high-g"
        name "Soprano Ukulele High G"
        tags ukulele, soprano, reentrant, highG
        course G4
        course C4
        course E4
        course A4
    }

    chordShape openA : A major {
        string 4 fret 2
        string 3 fret 1
        string 2 fret 0
        string 1 fret 0
    }

    chordShape openAMinor : A minor {
        string 4 fret 2
        string 3 fret 0
        string 2 fret 0
        string 1 fret 0
    }

    chordShape openA7 : A dominant7 {
        string 4 fret 0
        string 3 fret 1
        string 2 fret 0
        string 1 fret 0
    }

    chordShape openC : C major {
        string 4 fret 0
        string 3 fret 0
        string 2 fret 0
        string 1 fret 3
    }

    chordShape openCMinor : C minor {
        string 4 fret 0
        string 3 fret 3
        string 2 fret 3
        string 1 fret 3
    }

    chordShape openC7 : C dominant7 {
        string 4 fret 0
        string 3 fret 0
        string 2 fret 0
        string 1 fret 1
    }

    chordShape openD : D major {
        string 4 fret 2
        string 3 fret 2
        string 2 fret 2
        string 1 fret 0
    }

    chordShape openDMinor : D minor {
        string 4 fret 2
        string 3 fret 2
        string 2 fret 1
        string 1 fret 0
    }

    chordShape openD7 : D dominant7 {
        string 4 fret 2
        string 3 fret 0
        string 2 fret 2
        string 1 fret 0
    }

    chordShape openE : E major {
        string 4 fret 1
        string 3 fret 4
        string 2 fret 0
        string 1 fret 2
    }

    chordShape openEMinor : E minor {
        string 4 fret 0
        string 3 fret 4
        string 2 fret 3
        string 1 fret 2
    }

    chordShape openE7 : E dominant7 {
        string 4 fret 1
        string 3 fret 2
        string 2 fret 0
        string 1 fret 2
    }

    chordShape openF : F major {
        string 4 fret 2
        string 3 fret 0
        string 2 fret 1
        string 1 fret 0
    }

    chordShape openG : G major {
        string 4 fret 0
        string 3 fret 2
        string 2 fret 3
        string 1 fret 2
    }

    chordShape openG7 : G dominant7 {
        string 4 fret 0
        string 3 fret 2
        string 2 fret 1
        string 1 fret 2
    }
}
