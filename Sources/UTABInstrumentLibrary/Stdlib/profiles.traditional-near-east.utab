module profiles.traditional-near-east

profile LeveredCourseZither {
    id "profile:zither:levered-courses"
    version "1"
    actuator courses { minimumCount 24; maximumCount 27; control continuous; minimum 0.0; maximum 1.0 }
    actuator mandals { minimumCount 24; maximumCount 216; control discrete }
    interaction pluck { targets courses; effectors plectrum, finger }
    interaction setPitch { targets mandals; effectors finger }
    technique tremolo { target courses }
}

profile TiedFretPluckedCourses {
    id "profile:strings:tied-fret-plucked-courses"
    version "1"
    actuator courses { count 3; control continuous; minimum 0.0; maximum 1.0 }
    actuator tiedFrets { minimumCount 17; maximumCount 24; control discrete }
    interaction pluck { targets courses; effectors plectrum, finger }
    interaction stop { targets tiedFrets; effectors finger }
    interaction strikeSoundboard { targets courses; effectors finger }
    technique selpe { target courses }
    technique tremolo { target courses }
}

profile SpikeFiddle {
    id "profile:strings:spike-fiddle"
    version "1"
    actuator strings { minimumCount 3; maximumCount 4; control continuous; minimum 0.0; maximum 1.0 }
    actuator bow { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction bow { targets strings; effectors bow }
    interaction stop { targets strings; effectors finger }
    technique vibrato { target strings }
    technique glissando { target strings }
}

profile RimBlownFlute {
    id "profile:wind:rim-blown-flute"
    version "1"
    actuator airColumn { count 1; control continuous; minimum 0.0; maximum 1.0 }
    actuator toneHoles { count 7; control orderedBitset; width 7 }
    interaction blow { targets airColumn; effectors breath, lip }
    interaction cover { targets toneHoles; effectors finger }
    technique overblow { target airColumn }
    technique pitchBend { target airColumn }
    technique vibrato { target airColumn }
}

profile FolkDoubleReed {
    id "profile:wind:folk-double-reed"
    version "1"
    actuator reed { count 1; control continuous; minimum 0.0; maximum 1.0 }
    actuator toneHoles { minimumCount 8; maximumCount 10; control discrete }
    interaction blow { targets reed; effectors breath }
    interaction cover { targets toneHoles; effectors finger }
    technique halfHole { target toneHoles }
    technique pitchBend { target reed }
    technique vibrato { target reed }
}
