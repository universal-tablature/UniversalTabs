module instruments.guitarlele
import profiles.core
import std.midi

model Guitarlele : FrettedStrings {
    id "instrument:guitarlele:standard"
    name "Six-string Guitarlele"
    midiProgram = midi.nylonStringGuitar
    geometry strings { count 6 }
    geometry frets { count 18; movable false }
}

extension Guitarlele {
    tuning standard default {
        id "tuning:guitarlele:standard"
        name "Guitarlele Standard (A–A)"
        tags guitarlele, standard
        course A2
        course D3
        course G3
        course C4
        course E4
        course A4
    }
}
