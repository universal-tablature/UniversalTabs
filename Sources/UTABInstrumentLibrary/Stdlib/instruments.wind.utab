    geometry buttons { count 20; rows 2; bisonoric true; layout common20Button; commonKeys "C/G" }
    geometry buttonStateC1Push { button "C1"; direction push; pitch C3 }
    geometry buttonStateC1Pull { button "C1"; direction pull; pitch G3 }
    geometry buttonStateC2Push { button "C2"; direction push; pitch G3 }
