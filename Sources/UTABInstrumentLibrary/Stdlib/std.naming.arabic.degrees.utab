module std.naming.arabic.degrees

// Contextual degree names; the active scale determines pitches and intonation.
naming ArabicDegrees {
    register relativeRegister
    note qarar_rast = degree(1, 0)
    note duka = degree(2, 0)
    note sikah = degree(3, 0)
    note jaharkah = degree(4, 0)
    note nawa = degree(5, 0)
    note husayni = degree(6, 0)
    note awj = degree(7, 0)
    note kirdan = degree(8, 0)
}
