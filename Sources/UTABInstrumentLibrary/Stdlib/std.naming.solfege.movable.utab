module std.naming.solfege.movable

// Contextual degree names; the active scale determines pitches and intonation.
naming MovableSolfege {
    register relativeRegister
    note do = degree(1, 0)
    note re = degree(2, 0)
    note mi = degree(3, 0)
    note fa = degree(4, 0)
    note sol = degree(5, 0)
    note la = degree(6, 0)
    note ti = degree(7, 0)
}
