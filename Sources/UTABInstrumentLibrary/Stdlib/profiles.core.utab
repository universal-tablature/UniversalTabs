module profiles.core

profile FrettedStrings {
    id "profile:fretted-strings"
    version "1"
    actuator strings
    interaction setPosition { targets strings }
    interaction pluck { targets strings; effectors finger, pick }
    interaction damp { targets strings; effectors palm, finger }
    interaction strum {
        targets strings
        effectors finger, pick
        argument direction { values down, up; required }
        modifier accent
        modifier soft
        parameter spread { type duration; default "24ms" }
    }
    technique slide { target strings }
    technique bend { target strings }
    technique vibrato { target strings }
}

profile PluckedCourses {
    id "profile:plucked-courses"
    version "1"
    actuator courses
    actuator fretPositions { control continuous; minimum 0.0; maximum 1.0 }
    interaction setPosition { targets courses }
    interaction adjustFret { targets fretPositions; effectors hand }
    interaction pluck { targets courses; effectors finger, plectrum }
    interaction strum {
        targets courses
        effectors finger, plectrum
        argument direction { values down, up; required }
        modifier accent
    }
    technique tremolo { target courses }
}

profile PluckedOpenStrings {
    id "profile:plucked-open-strings"
    version "1"
    actuator strings { minimumCount 1; maximumCount 32 }
    interaction pluck { targets strings; effectors finger, plectrum }
    interaction strum {
        targets strings
        effectors finger, plectrum
        argument direction { values down, up; required }
        modifier accent
    }
    technique damp { target strings }
}

profile FretlessBowedStrings {
    id "profile:fretless-bowed-strings"
    version "1"
    actuator strings {
        minimumCount 1
        maximumCount 16
        control continuous
        minimum 0.0
        maximum 1.0
    }
    interaction setPosition { targets strings }
    interaction bow {
        targets strings
        effectors bow
        argument direction { values down, up; required }
        modifier accent
        modifier legato
        parameter pressure { type decimal; minimum 0; maximum 1 }
        parameter contactPoint { type decimal; minimum 0; maximum 1 }
    }
    interaction pluck { targets strings; effectors finger }
    technique vibrato { target strings }
    technique pizzicato { target strings }
}

profile FretlessPluckedStrings {
    id "profile:fretless-plucked-strings"
    version "1"
    actuator strings {
        minimumCount 1
        maximumCount 16
        control continuous
        minimum 0.0
        maximum 1.0
    }
    interaction setPosition { targets strings }
    interaction pluck { targets strings; effectors finger }
    interaction damp { targets strings; effectors palm, finger }
    technique slide { target strings }
    technique bend { target strings }
    technique vibrato { target strings }
}

profile Keyboard {
    id "profile:keyboard"
    version "1"
    actuator keys { count 88 }
    actuator pedals { count 3; control continuous; minimum 0.0; maximum 1.0 }
    interaction press { targets keys; effectors finger }
    interaction press { targets pedals; effectors foot }
}

profile SingingVoice {
    id "profile:singing-voice"
    version "1"
    actuator voice { count 1; control continuous }
    interaction sing { targets voice; effectors breath }
    technique vibrato { target voice }
}
