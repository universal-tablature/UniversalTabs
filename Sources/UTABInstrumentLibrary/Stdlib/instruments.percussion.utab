module instruments.percussion
import profiles.percussion
import std.midi

model SnareDrum : UnpitchedPercussion {
    id "instrument:percussion:snare-drum"
    name "Snare Drum"
    midiPercussion true
    geometry playingSurfaces { count 1; membrane true; snares true; midiNote midi.acousticSnareNote }
}

model BassDrum : UnpitchedPercussion {
    id "instrument:percussion:bass-drum"
    name "Bass Drum"
    midiPercussion true
    geometry playingSurfaces { count 2; membrane true; midiNote midi.acousticBassDrumNote }
}

model Tambourine : UnpitchedPercussion {
    id "instrument:percussion:tambourine"
    name "Tambourine"
    midiPercussion true
    geometry playingSurfaces { count 1; membrane true; jingles true; midiNote midi.tambourineNote }
}

model Triangle : UnpitchedPercussion {
    id "instrument:percussion:triangle"
    name "Triangle"
    midiPercussion true
    geometry playingSurfaces { count 1; material metal; midiNote midi.openTriangleNote }
}

model DrumKit : UnpitchedPercussion {
    id "instrument:percussion:drum-kit"
    name "Drum Kit"
    midiPercussion true
    geometry playingSurfaces { minimumCount 5; collection true; drums true; cymbals true }
    geometry kick { target playingSurfaces; member "kick"; midiNote midi.electricBassDrumNote }
    geometry snareHead { target playingSurfaces; member "snare-head"; midiNote midi.acousticSnareNote }
    geometry closedHiHat { target playingSurfaces; member "closed-hi-hat"; midiNote midi.closedHiHatNote }
    geometry crash { target playingSurfaces; member "crash"; midiNote midi.crashCymbal1Note }
}

model Xylophone : PitchedPercussion {
    id "instrument:percussion:xylophone"
    name "Xylophone"
    midiProgram = midi.xylophone
    geometry bars { material wood; chromatic true; typicalRange "F3-C7" }
}

model Marimba : PitchedPercussion {
    id "instrument:percussion:marimba"
    name "Marimba"
    midiProgram = midi.marimba
    geometry bars { material wood; chromatic true; resonators true; typicalRange "C2-C7" }
}

model Glockenspiel : PitchedPercussion {
    id "instrument:percussion:glockenspiel"
    name "Glockenspiel"
    midiProgram = midi.glockenspiel
    geometry bars { material metal; chromatic true; typicalRange "G5-C8" }
}

model Vibraphone : PitchedPercussion {
    id "instrument:percussion:vibraphone"
    name "Vibraphone"
    midiProgram = midi.vibraphone
    geometry bars { material metal; chromatic true; motorizedResonators true; typicalRange "F3-F6" }
    geometry pedal { damper true }
}

model Timpani : TunableDrums {
    id "instrument:percussion:timpani"
    name "Timpani"
    midiProgram = midi.timpani
    geometry membranes { typicalCount 4; definitePitch true; typicalRange "D2-A3" }
    geometry tuningControls { count 4; pedal true; continuous true; statePersistsUntilRetuned true }
    geometry drum32 { diameterInches 32; stateKey "drum32"; minimum D2; maximum A2; initial D2 }
    geometry drum29 { diameterInches 29; stateKey "drum29"; minimum F2; maximum C3; initial F2 }
    geometry drum26 { diameterInches 26; stateKey "drum26"; minimum Bb2; maximum F3; initial Bb2 }
    geometry drum23 { diameterInches 23; stateKey "drum23"; minimum D3; maximum A3; initial D3 }
    geometry strikeDrum32 { interaction strike; target "drum32"; stateValue "drum32" }
    geometry strikeDrum29 { interaction strike; target "drum29"; stateValue "drum29" }
    geometry strikeDrum26 { interaction strike; target "drum26"; stateValue "drum26" }
    geometry strikeDrum23 { interaction strike; target "drum23"; stateValue "drum23" }
}

model SuspendedCymbal : DampedMetalPercussion {
    id "instrument:percussion:cymbal-suspended"
    name "Suspended Cymbal"
    midiPercussion true
    geometry playingSurfaces { count 1; material bronze; suspended true; midiNote midi.crashCymbal2Note; midiFidelity approximate }
    geometry damping { count 1; choke true; handDamping true }
}

model CrashCymbals : DampedMetalPercussion {
    id "instrument:percussion:cymbals-crash-pair"
    name "Pair of Crash Cymbals"
    midiPercussion true
    geometry playingSurfaces { count 2; material bronze; handheld true; midiNote midi.crashCymbal1Note }
    geometry damping { count 2; choke true; bodyDamping true }
}

model HiHat : PedalHiHat {
    id "instrument:percussion:hi-hat"
    name "Pedal Hi-hat"
    midiPercussion true
    geometry cymbals { count 2; material bronze }
    geometry pedal { continuousOpenness true; statePersists true; initially closed }
    geometry closedStroke { interaction strike; state closed; midiNote midi.closedHiHatNote }
    geometry openStroke { interaction strike; state open; midiNote midi.openHiHatNote }
    geometry footStroke { interaction footClose; midiNote midi.pedalHiHatNote }
}

model TomToms : UnpitchedPercussion {
    id "instrument:percussion:tom-toms-six-piece"
    name "Six-piece Tom-tom Set"
    midiPercussion true
    geometry playingSurfaces { count 6; membranes true; tunedRelatively true }
    geometry lowFloorTom { midiNote midi.lowFloorTomNote }
    geometry highFloorTom { midiNote midi.highFloorTomNote }
    geometry lowTom { midiNote midi.lowTomNote }
    geometry lowMidTom { midiNote midi.lowMidTomNote }
    geometry highMidTom { midiNote midi.highMidTomNote }
    geometry highTom { midiNote midi.highTomNote }
}

model TamTam : DampedMetalPercussion {
    id "instrument:percussion:tam-tam"
    name "Tam-tam"
    midiPercussion true
    geometry playingSurfaces { count 1; material bronze; bossed false; suspended true; midiNote midi.chineseCymbalNote; midiFidelity approximate }
    geometry damping { count 1; handDamping true; statePersists true }
}

model TubularBells : DampedPitchedPercussion {
    id "instrument:percussion:tubular-bells"
    name "Tubular Bells"
    midiProgram = midi.tubularBells
    geometry bars { material metal; tubular true; chromatic true; typicalRange "C4-F5" }
    geometry damper { pedal true; normallyEngaged true }
}

model Woodblock : UnpitchedPercussion {
    id "instrument:percussion:woodblock-pair"
    name "Woodblock Pair"
    midiPercussion true
    geometry playingSurfaces { count 2; material wood }
    geometry highBlock { midiNote midi.highWoodblockNote }
    geometry lowBlock { midiNote midi.lowWoodblockNote }
}

model Claves : UnpitchedPercussion {
    id "instrument:percussion:claves"
    name "Claves"
    midiPercussion true
    geometry playingSurfaces { count 2; material wood; struckTogether true; midiNote midi.clavesNote }
}

model Maracas : ShakenPercussion {
    id "instrument:percussion:maracas-pair"
    name "Pair of Maracas"
    midiPercussion true
    geometry body { count 2; filledVessel true; midiNote midi.maracasNote }
}

model Castanets : UnpitchedPercussion {
    id "instrument:percussion:castanets-pair"
    name "Pair of Castanets"
    midiPercussion true
    geometry playingSurfaces { count 2; shellPairs true; handheld true; midiNote midi.clavesNote; midiFidelity approximate }
}
