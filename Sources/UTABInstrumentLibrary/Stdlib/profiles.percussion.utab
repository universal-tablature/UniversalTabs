module profiles.percussion

profile UnpitchedPercussion {
    id "profile:percussion:unpitched"
    version "1"
    actuator playingSurfaces { minimumCount 1 }
    interaction strike { targets playingSurfaces; effectors hand, stick, mallet }
    technique roll { target playingSurfaces }
}

profile PitchedPercussion {
    id "profile:percussion:pitched"
    version "1"
    actuator bars { minimumCount 1 }
    interaction strike { targets bars; effectors mallet }
    technique roll { target bars }
}

profile TunableDrums {
    id "profile:percussion:tunable-drums"
    version "1"
    actuator membranes { minimumCount 1 }
    actuator tuningControls { control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors mallet, hand }
    interaction setPitch { targets tuningControls; effectors hand, foot }
    technique roll { target membranes }
}

profile DampedMetalPercussion {
    id "profile:percussion:damped-metal"
    version "1"
    actuator playingSurfaces { minimumCount 1 }
    actuator damping { minimumCount 1; control binary }
    interaction strike { targets playingSurfaces; effectors hand, stick, mallet }
    interaction damp { targets damping; effectors hand, pedal }
    interaction choke { targets playingSurfaces, damping; effectors hand }
    technique roll { target playingSurfaces }
}

profile PedalHiHat {
    id "profile:percussion:pedal-hi-hat"
    version "1"
    actuator cymbals { count 2 }
    actuator pedal { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets cymbals; effectors stick, brush }
    interaction setOpenness { targets pedal; effectors foot }
    interaction footClose { targets pedal; effectors foot }
    interaction choke { targets cymbals; effectors hand }
}

profile DampedPitchedPercussion {
    id "profile:percussion:damped-pitched"
    version "1"
    actuator bars { minimumCount 1 }
    actuator damper { count 1; control binary }
    interaction strike { targets bars; effectors mallet }
    interaction damp { targets damper; effectors hand, pedal }
    technique roll { target bars }
}

profile ShakenPercussion {
    id "profile:percussion:shaken"
    version "1"
    actuator body { minimumCount 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction shake { targets body; effectors hand }
    interaction strike { targets body; effectors hand }
    technique roll { target body }
}

profile HandDrum {
    id "profile:percussion:hand-drum"
    version "1"
    actuator membrane { count 1; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membrane; effectors finger, hand }
    interaction damp { targets damping; effectors finger, hand }
    technique roll { target membrane }
    technique fingerRoll { target membrane }
}

profile JingledFrameDrum {
    id "profile:percussion:jingled-frame-drum"
    version "1"
    actuator membrane { count 1; control continuous; minimum 0.0; maximum 1.0 }
    actuator jingles { minimumCount 1; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membrane; effectors finger, hand }
    interaction shake { targets jingles; effectors hand }
    interaction damp { targets damping; effectors finger, hand }
    technique roll { target membrane }
    technique jingleRoll { target jingles }
}

profile PressureTunedDrumPair {
    id "profile:percussion:pressure-tuned-drum-pair"
    version "1"
    actuator membranes { count 2; control continuous; minimum 0.0; maximum 1.0 }
    actuator tuningControls { count 2; control continuous; minimum 0.0; maximum 1.0 }
    actuator pressure { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors finger, hand }
    interaction tune { targets tuningControls; effectors hand, tool }
    interaction press { targets pressure; effectors hand }
    technique pitchBend { target pressure }
    technique roll { target membranes }
}

profile DoubleHeadedBarrelDrum {
    id "profile:percussion:double-headed-barrel-drum"
    version "1"
    actuator membranes { count 2; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { count 2; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors finger, hand }
    interaction damp { targets damping; effectors finger, hand }
    technique roll { target membranes }
}

profile SqueezableFrameDrum {
    id "profile:percussion:squeezable-frame-drum"
    version "1"
    actuator membrane { count 1; control continuous; minimum 0.0; maximum 1.0 }
    actuator jingles { minimumCount 1; control continuous; minimum 0.0; maximum 1.0 }
    actuator tension { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membrane; effectors finger, hand }
    interaction shake { targets jingles; effectors hand }
    interaction squeeze { targets tension; effectors hand }
    technique pitchBend { target tension }
}

profile ClayPotPercussion {
    id "profile:percussion:clay-pot"
    version "1"
    actuator surfaces { minimumCount 3; control continuous; minimum 0.0; maximum 1.0 }
    actuator opening { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets surfaces; effectors finger, hand, wrist }
    interaction cover { targets opening; effectors hand, body }
    technique pitchBend { target opening }
}

profile StrappedDoubleHeadedDrum {
    id "profile:percussion:strapped-double-headed-drum"
    version "1"
    actuator membranes { count 2; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { count 2; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors hand, straightStick, curvedStick }
    interaction damp { targets damping; effectors hand }
    technique roll { target membranes }
}

profile PressureCordDrum {
    id "profile:percussion:pressure-cord-drum"
    version "1"
    actuator membranes { count 2; control continuous; minimum 0.0; maximum 1.0 }
    actuator tensionCords { minimumCount 8; maximumCount 32; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors curvedStick, hand }
    interaction squeeze { targets tensionCords; effectors arm, body }
    technique pitchBend { target tensionCords }
}

profile MultiHandDrum {
    id "profile:percussion:multi-hand-drum"
    version "1"
    actuator membranes { minimumCount 2; maximumCount 8; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { minimumCount 2; maximumCount 8; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors finger, hand }
    interaction damp { targets damping; effectors finger, hand }
    technique roll { target membranes }
}

profile StickDrumSet {
    id "profile:percussion:stick-drum-set"
    version "1"
    actuator membranes { minimumCount 2; maximumCount 8; control continuous; minimum 0.0; maximum 1.0 }
    actuator rims { minimumCount 2; maximumCount 8 }
    actuator accessories { minimumCount 1; maximumCount 8 }
    interaction strike { targets membranes, rims, accessories; effectors stick }
    technique roll { target membranes }
}

profile MultiSurfaceBoxDrum {
    id "profile:percussion:multi-surface-box-drum"
    version "1"
    actuator surfaces { minimumCount 3; maximumCount 12; control continuous; minimum 0.0; maximum 1.0 }
    actuator snares { minimumCount 1; maximumCount 2; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets surfaces; effectors finger, hand, brush }
    interaction adjust { targets snares; effectors hand }
    technique roll { target surfaces }
}

profile ScrapedPercussion {
    id "profile:percussion:scraped"
    version "1"
    actuator ridges { count 1; control continuous; minimum 0.0; maximum 1.0 }
    interaction scrape { targets ridges; effectors scraper, stick }
    interaction strike { targets ridges; effectors stick }
    technique longScrape { target ridges }
    technique shortScrape { target ridges }
}

profile MountedDoubleHeadedDrum {
    id "profile:percussion:mounted-double-headed-drum"
    version "1"
    actuator membranes { count 2; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { count 2; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors stick }
    interaction damp { targets damping; effectors hand }
    technique roll { target membranes }
}

profile AsymmetricDoubleHeadedDrum {
    id "profile:percussion:asymmetric-double-headed-drum"
    version "1"
    actuator membranes { minimumCount 2; maximumCount 4; control continuous; minimum 0.0; maximum 1.0 }
    actuator tensionCords { minimumCount 8; maximumCount 32; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets membranes; effectors hand, thinStick, mallet }
    interaction tune { targets tensionCords; effectors hand }
    technique roll { target membranes }
}

profile BossedGongRack {
    id "profile:percussion:bossed-gong-rack"
    version "1"
    actuator gongKettles { minimumCount 10; maximumCount 14; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { minimumCount 10; maximumCount 14; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets gongKettles; effectors paddedMallet }
    interaction damp { targets damping; effectors hand, mallet }
    technique pipilan { target gongKettles }
    technique gembyangan { target gongKettles }
}

profile TroughMetallophone {
    id "profile:percussion:trough-metallophone"
    version "1"
    actuator keys { minimumCount 6; maximumCount 7; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { minimumCount 6; maximumCount 7; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets keys; effectors hardMallet }
    interaction damp { targets damping; effectors freeHand }
}

profile ResonatedSuspendedMetallophone {
    id "profile:percussion:resonated-suspended-metallophone"
    version "1"
    actuator keys { minimumCount 10; maximumCount 14; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { minimumCount 10; maximumCount 14; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets keys; effectors paddedDiscMallet }
    interaction damp { targets damping; effectors hand }
    technique cengkok { target keys }
}

profile HangingBossedGongSet {
    id "profile:percussion:hanging-bossed-gong-set"
    version "1"
    actuator gongs { minimumCount 2; maximumCount 16; control continuous; minimum 0.0; maximum 1.0 }
    actuator damping { minimumCount 2; maximumCount 16; control continuous; minimum 0.0; maximum 1.0 }
    interaction strike { targets gongs; effectors paddedBeater }
    interaction damp { targets damping; effectors hand }
}
