module instruments.guitar
import profiles.core
import std.midi

model Guitar : FrettedStrings {
    id "instrument:guitar:classical-six-string"
    name "Six-string Classical Guitar"
    midiProgram = midi.nylonStringGuitar
    geometry strings { count 6 }
    geometry frets { count 19; movable false }
}

extension Guitar {
    tuning standard default {
        id "tuning:guitar:standard"
        name "Guitar Standard"
        tags guitar, standard
        course E2
        course A2
        course D3
        course G3
        course B3
        course E4
    }

    movableChordShape cagedEMajor : major {
        root string 6
        string 6 fret 0
        string 5 fret 2
        string 4 fret 2
        string 3 fret 1
        string 2 fret 0
        string 1 fret 0
    }

    movableChordShape cagedEMinor : minor {
        root string 6
        string 6 fret 0
        string 5 fret 2
        string 4 fret 2
        string 3 fret 0
        string 2 fret 0
        string 1 fret 0
    }

    movableChordShape cagedE7 : dominant7 {
        root string 6
        string 6 fret 0
        string 5 fret 2
        string 4 fret 0
        string 3 fret 1
        string 2 fret 0
        string 1 fret 0
    }

    movableChordShape cagedAMajor : major {
        root string 5
        string 5 fret 0
        string 4 fret 2
        string 3 fret 2
        string 2 fret 2
        string 1 fret 0
    }

    movableChordShape cagedAMinor : minor {
        root string 5
        string 5 fret 0
        string 4 fret 2
        string 3 fret 2
        string 2 fret 1
        string 1 fret 0
    }

    movableChordShape cagedA7 : dominant7 {
        root string 5
        string 5 fret 0
        string 4 fret 2
        string 3 fret 0
        string 2 fret 2
        string 1 fret 0
    }

    movableChordShape powerChord : power {
        root string 6
        string 6 fret 0
        string 5 fret 2
        string 4 fret 2
    }

    chordShape cagedEBarreF : F major {
        string 6 fret 1
        string 5 fret 3
        string 4 fret 3
        string 3 fret 2
        string 2 fret 1
        string 1 fret 1
    }

    chordShape cagedEMinorBarreF : F minor {
        string 6 fret 1
        string 5 fret 3
        string 4 fret 3
        string 3 fret 1
        string 2 fret 1
        string 1 fret 1
    }

    chordShape cagedAMinorBarreB : B minor {
        string 5 fret 2
        string 4 fret 4
        string 3 fret 4
        string 2 fret 3
        string 1 fret 2
    }

    chordShape openA : A major {
        string 5 fret 0
        string 4 fret 2
        string 3 fret 2
        string 2 fret 2
        string 1 fret 0
    }

    chordShape openAMinor : A minor {
        string 5 fret 0
        string 4 fret 2
        string 3 fret 2
        string 2 fret 1
        string 1 fret 0
    }

    chordShape openA7 : A dominant7 {
        string 5 fret 0
        string 4 fret 2
        string 3 fret 0
        string 2 fret 2
        string 1 fret 0
    }

    chordShape openB7 : B dominant7 {
        string 5 fret 2
        string 4 fret 1
        string 3 fret 2
        string 2 fret 0
        string 1 fret 2
    }

    chordShape openC : C major {
        string 5 fret 3
        string 4 fret 2
        string 3 fret 0
        string 2 fret 1
        string 1 fret 0
    }

    chordShape openC7 : C dominant7 {
        string 5 fret 3
        string 4 fret 2
        string 3 fret 3
        string 2 fret 1
        string 1 fret 0
    }

    chordShape openD : D major {
        string 4 fret 0
        string 3 fret 2
        string 2 fret 3
        string 1 fret 2
    }

    chordShape openDMinor : D minor {
        string 4 fret 0
        string 3 fret 2
        string 2 fret 3
        string 1 fret 1
    }

    chordShape openD7 : D dominant7 {
        string 4 fret 0
        string 3 fret 2
        string 2 fret 1
        string 1 fret 2
    }

    chordShape openE : E major {
        string 6 fret 0
        string 5 fret 2
        string 4 fret 2
        string 3 fret 1
        string 2 fret 0
        string 1 fret 0
    }

    chordShape openEMinor : E minor {
        string 6 fret 0
        string 5 fret 2
        string 4 fret 2
        string 3 fret 0
        string 2 fret 0
        string 1 fret 0
    }

    chordShape openE7 : E dominant7 {
        string 6 fret 0
        string 5 fret 2
        string 4 fret 0
        string 3 fret 1
        string 2 fret 0
        string 1 fret 0
    }

    chordShape openG : G major {
        string 6 fret 3
        string 5 fret 2
        string 4 fret 0
        string 3 fret 0
        string 2 fret 0
        string 1 fret 3
    }

    chordShape openGHighD : G major {
        string 6 fret 3
        string 5 fret 2
        string 4 fret 0
        string 3 fret 0
        string 2 fret 3
        string 1 fret 3
    }

    chordShape openG7 : G dominant7 {
        string 6 fret 3
        string 5 fret 2
        string 4 fret 0
        string 3 fret 0
        string 2 fret 0
        string 1 fret 1
    }

    chordShape cagedEBarreG : G major {
        string 6 fret 3
        string 5 fret 5
        string 4 fret 5
        string 3 fret 4
        string 2 fret 3
        string 1 fret 3
    }

    chordShape cagedABarreG : G major {
        string 5 fret 10
        string 4 fret 12
        string 3 fret 12
        string 2 fret 12
        string 1 fret 10
    }
}
